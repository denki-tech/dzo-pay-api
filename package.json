{
  "name": "d-zo-pay",
  "version": "1.0.0",
  "description": "Production-grade fintech payment API with multi-provider support, virtual wallets, and admin analytics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --verbose",
