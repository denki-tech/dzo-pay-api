# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1
API_BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/dzo_pay
MONGODB_TEST_URI=mongodb://localhost:27017/dzo_pay_test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=1h

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public

# Flutterwave
FLW_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public
FLW_ENCRYPTION_KEY=your-flutterwave-encryption-key
FLW_WEBHOOK_SECRET=your-flutterwave-webhook-secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@dzo-pay.com
SMTP_SECURE=false

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SMS (Termii - Alternative)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=DZOPay

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Features
ENABLE_MFA=true
ENABLE_WEBHOOK_RETRY=true
ENABLE_FRAUD_DETECTION=true
ENABLE_REALTIME_NOTIFICATIONS=true
ENABLE_IP_GEOLOCATION=true

# Admin
ADMIN_SECRET_KEY=your-admin-secret-key
ADMIN_DEFAULT_EMAIL=admin@dzo-pay.com
ADMIN_DEFAULT_PASSWORD=Admin@123456

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=30
LOG_MAX_SIZE=20m

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Webhook Retry
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=60000
WEBHOOK_TIMEOUT_MS=30000

# Cleanup Jobs
OTP_EXPIRY_MINUTES=10
ARCHIVE_LOGS_DAYS=90
DAILY_REPORT_HOUR=2

# Currency
DEFAULT_CURRENCY=NGN
SUPPORTED_CURRENCIES=NGN,USD,GHS,KES,ZAR,EUR,GBP
